# Server
PORT=5000
NODE_ENV=development

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=groupsync_db
DB_USER=postgres
DB_PASSWORD=postgres

# When running via docker-compose, DB_HOST should be "db" (the service name)

# JWT
JWT_SECRET=long_random_secret_key
JWT_EXPIRES_IN=7d

# CORS
CLIENT_ORIGIN=http://localhost:5173
